# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,localhost
DJANGO_SETTINGS_MODULE=config.settings.production

# Database
DATABASE_URL=postgres://user:pass@db:5432/wxradar

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# AWS — all NOAA buckets are unsigned/public, no credentials needed
AWS_NEXRAD_BUCKET=noaa-nexrad-level2
AWS_MRMS_BUCKET=noaa-mrms-pds
AWS_REGION=us-east-1

# MRMS national mosaic (always-on background task)
MRMS_POLL_INTERVAL=120

# Per-station NEXRAD (on-demand)
STATION_POLL_INTERVAL=90
STATION_SCAN_TTL=1800
NOWCAST_TIMESTEPS=12
HAIL_MESH_THRESHOLD=25

# NWS Alerts — national, no state filter
NWS_ALERTS_POLL_INTERVAL=60
NWS_USER_AGENT=(wxradar, contact@youremail.com)

# Storage
TILE_OUTPUT_DIR=/app/data/tiles
SCAN_CACHE_DIR=/app/data/scans
MRMS_CACHE_DIR=/app/data/mrms
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media

# Production only
SENTRY_DSN=
POSTGRES_PASSWORD=changeme
