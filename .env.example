# ── Local dev (copy this to .env and set SECRET_KEY) ──────────────────────────
SECRET_KEY=change-me-use-django-get-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite — no Postgres needed for local dev
DATABASE_URL=sqlite:///db.sqlite3

# Redis — only needed if you start a real Celery worker.
# Development settings run tasks eagerly (inline) so Redis is optional.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

NWS_USER_AGENT=(wxradar, your@email.com)

# Data dirs default to <project root>/data/{tiles,scans,mrms} — no override needed locally.
# TILE_OUTPUT_DIR=
# SCAN_CACHE_DIR=
# MRMS_CACHE_DIR=

# ── Production only (fill in when deploying) ───────────────────────────────────
# SECRET_KEY=<strong random key>
# DEBUG=False
# ALLOWED_HOSTS=yourdomain.com
# DATABASE_URL=postgres://user:pass@db:5432/wxradar
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/1
# TILE_OUTPUT_DIR=/app/data/tiles
# SCAN_CACHE_DIR=/app/data/scans
# MRMS_CACHE_DIR=/app/data/mrms
# STATIC_ROOT=/app/staticfiles
# MEDIA_ROOT=/app/media
# SENTRY_DSN=
# POSTGRES_PASSWORD=changeme
